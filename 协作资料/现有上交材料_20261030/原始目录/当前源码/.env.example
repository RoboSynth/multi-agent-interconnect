# Optional review settings. Copy to .env before first start to change ports.
# Empty secrets are generated locally; do not fill real credentials in this example.
COMPOSE_PROJECT_NAME=incident-review
WORKBENCH_PORT=18766
ORDER_PORT=18088
APP_V1_PORT=18081
APP_V2_PORT=18082
ORDER_BIND=127.0.0.1
POSTGRES_PASSWORD=
ORDERS_DB_PASSWORD=
APP_ADMIN_TOKEN=
BRIDGE_DB_PASSWORD=
