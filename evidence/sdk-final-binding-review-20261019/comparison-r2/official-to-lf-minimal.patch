+             SDK_ROOT / "acps_sdk/aip/_task_order.py", SDK_ROOT / "acps_sdk/aip/aip_base_model.py"]
+    return {path.relative_to(SDK_ROOT).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in paths}
+
+
+def snapshot(journal, term, leader, phase):
