+            "authorization_endpoint",
+            "device_authorization_endpoint",
+            "token_endpoint",
+            "revocation_endpoint",
+            "end_session_endpoint",
+        ):
+            endpoint = getattr(document, endpoint_name)
+            if endpoint:
