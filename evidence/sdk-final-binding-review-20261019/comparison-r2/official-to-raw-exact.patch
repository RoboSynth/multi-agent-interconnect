+
+class MetricFamily(str, Enum):
+    """AMP 指标族。"""
+
+    SAMPLE_COUNT_GAUGE = "sample_count_gauge"
+    """采样计数 Gauge（activeTasks / queuedTasks / max* 等瞬时计数）。"""
+
+    RESOURCE_USAGE_GAUGE = "resource_usage_gauge"
