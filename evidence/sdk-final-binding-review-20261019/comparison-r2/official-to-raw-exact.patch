+def _bind_default_task_result_identity(
+    result: TaskResult,
+    local_aic: str | None,
+) -> TaskResult:
+    """Backfill the built-in TaskManager placeholder sender with the real local AIC."""
+    if local_aic and result.senderId == _DEFAULT_TASK_RESULT_SENDER:
+        result.senderId = local_aic
+    return result
