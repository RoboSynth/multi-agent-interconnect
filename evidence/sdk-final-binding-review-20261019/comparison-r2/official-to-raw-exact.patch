+    "avgLatencyMs": PublicMetricMeta(
+        public_name="avgLatencyMs",
+        family=MetricFamily.WINDOW_RATE_LATENCY,
+        needs_window=True,
+        fixed_quantile=None,
+    ),
+    # ── WindowMetrics：总量类 ────────────────────────────────────────────────
+    "requestTotal": PublicMetricMeta(
