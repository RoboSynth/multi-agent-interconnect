+def build_settlement_body(
+    event_type: str,
+    *,
+    system: str,
+    exchange: str,
+    virtual_host: str,
+    queue_name: str,
+    message_id: str,
+    delivery_attempt: int,
+    latency_ms: float,
+    reason: str | None = None,
+    error: ErrorInfo | None = None,
+) -> MessageBody:
+    """结算类事件（ack/nack/reject/timeout/dead_letter）body 组装。"""
