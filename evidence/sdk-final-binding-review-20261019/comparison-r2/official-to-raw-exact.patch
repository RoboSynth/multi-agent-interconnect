+            "connected": self.connected,
+            "muted": self.muted,
+            "joined_at": self.joined_at,
+        }
+
+
+# 消息处理回调类型
+MessageHandler = Callable[
+    [Union[TaskCommand, TaskResult, GroupMgmtCommand, GroupMgmtResult]],
+    Awaitable[None],
+]
