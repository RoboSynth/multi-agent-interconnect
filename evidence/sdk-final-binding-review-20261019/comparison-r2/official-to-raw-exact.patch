+    assert record["severity_number"] == 9
+    assert record["severity_text"] == "INFO"
+    assert record["correlation_id"] == "tid-1"
+    assert record["resource"] == resource
+    assert record["body"]["message"] == "hi"
+    assert "integrity" not in record
+
