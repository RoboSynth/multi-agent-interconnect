+"""tests: passes_seq_gate / is_gap / passes_version / classify_delta 纯函数。"""
+import pytest
+
+from acps_sdk.amp.alive_sync.engine import (
+    DeltaDecision,
+    classify_delta,
+    is_gap,
+    passes_seq_gate,
