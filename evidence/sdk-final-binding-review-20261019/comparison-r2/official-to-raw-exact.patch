-        aic: 待验证的 AIC 字符串
-        expected_prefix: 期望的 OID 前缀
-
-    Returns:
-        格式是否有效
-    """
-    valid, _ = validate_aic_format(aic, expected_prefix=expected_prefix)
-    return valid
