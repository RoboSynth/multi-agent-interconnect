+                url,
+                data=payload,
+                headers={"Accept": "application/json"},
+            )
+        except httpx.HTTPError as exc:
+            raise OidcClientError(f"OIDC request to {url} failed") from exc
+
+    def _post_form(
+        self, url: str, payload: dict[str, str], *, endpoint_name: str
+    ) -> dict[str, Any]:
